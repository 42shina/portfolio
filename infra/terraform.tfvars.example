aws_region   = "ap-northeast-1"
project_name = "my-portfolio"

# Enable after configuring the production environment in GitHub.
github_repository    = "42shina/portfolio"
# Numeric IDs from CloudTrail userName / GitHub API (owner@id / repo@id in OIDC sub).
github_owner_id      = "160340038"
github_repository_id = "1387463809"
# If this AWS account already has a GitHub OIDC provider, reuse its ARN:
# github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
